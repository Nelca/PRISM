# このファイルをコピーして .env を作る(.env はコミットしない)。
#   cp .env.example .env

# --- データベース ---
# compose.yaml のDBに接続する場合の既定値。
# マイグレーション実行用(スキーマ所有者)。drizzle-kit はこちらを使う。
DATABASE_URL_MIGRATOR=postgres://prism_migrator:prism_local_dev@localhost:5433/prism
# アプリ実行用。台帳テーブルへのUPDATE/DELETE権限を持たない(M8 D-5)。
DATABASE_URL=postgres://prism_app:prism_local_dev@localhost:5433/prism

# --- テナント ---
# 認証はこのリポジトリで実装しない(D-111)。ハーネスが使う既定テナントのIDを指定する。
PRISM_DEFAULT_TENANT_ID=demo-tenant

# --- 出力API ---
# /api/pipeline-result の x-api-key に要求する値。
# 未設定の場合、APIは503を返して停止する(未設定を「全開放」にしない。GAP-16)。
PRISM_API_KEY=

# --- Basic認証(デプロイ先の公開制限) ---
# 両方を設定したときだけ有効になる。未設定のローカル開発では認証を要求しない。
# Vercelでは Project Settings > Environment Variables に設定する。
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
